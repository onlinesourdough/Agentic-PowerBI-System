{
  "name": "agentic-powerbi-system",
  "version": "0.2.0",
  "description": "Agentic Power BI System: a standalone, decision-first Power BI workflow with durable proof.",
  "keywords": [
    "agentic-system",
    "agent-skills",
    "power-bi",
    "pbip",
    "pbir",
    "tmdl",
    "fabric",
    "business-analytics"
  ],
  "license": "MIT",
  "files": [
    "AGENTS.md",
    "README.md",
    "LICENSE",
    ".agents/skills",
    "docs",
    "examples",
    "workspace/PROJECT-BRIEF.md",
    "workspace/README.md",
    "workspace/briefs",
    "workspace/models",
    "workspace/reports",
    "workspace/state",
    "workspace/runs",
    "workspace/history/runs.jsonl",
    "workspace/learning",
    "workspace/engine/checks.py",
    "workspace/engine/doctor.mjs",
    "workspace/engine/seed-guard.mjs",
    "workspace/engine/tracer.py",
    "workspace/engine/validate-pbip.mjs",
    "workspace/engine/tests/test_template.py",
    "workspace/engine/tests/test-validator.mjs",
    "workspace/engine/tests/fixtures"
  ],
  "scripts": {
    "doctor": "node workspace/engine/doctor.mjs",
    "validate": "node workspace/engine/validate-pbip.mjs . --ignore-tests",
    "test": "node workspace/engine/tests/test-validator.mjs && python3 -m unittest discover -s workspace/engine/tests -p 'test_*.py'",
    "trace": "python3 workspace/engine/tracer.py --promote-example",
    "prepack": "node workspace/engine/seed-guard.mjs"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.9"
  }
}
