{
  "name": "powerbi-template",
  "version": "0.2.0",
  "description": "Project-local context, skills, and validation for owned Power BI solutions.",
  "keywords": [
    "pi-package",
    "agent-skills",
    "power-bi",
    "pbip",
    "pbir",
    "tmdl",
    "fabric",
    "business-analytics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onlinesourdough/PowerBI-template.git"
  },
  "pi": {
    "extensions": ["extensions/index.ts"],
    "skills": [".agents/skills"],
    "prompts": ["prompts"]
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "validate": "node scripts/validate-pbip.mjs . --ignore-tests",
    "test": "node tests/test-validator.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
